<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:animateLayoutChanges="true">

    <!-- ── LIVE UPDATE BANNER ─────────────────────────────────────────── -->
    <!-- Pinned under the header, above the value it updates (the Marker design). Shown while a
         background price move is held for the user to apply. The neon marks it because it's the
         one thing on Home that asks for a tap. -->
    <LinearLayout
        android:id="@+id/banner_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_color"
        android:visibility="gone"
        tools:visibility="visible">

    <LinearLayout
        android:id="@+id/banner_portfolio_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_marker_banner"
        android:minHeight="46dp"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingVertical="8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/tv_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Portfolio updated — tap to apply"
            android:textColor="@color/on_marker"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semi_bold"/>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_arrow_up_right"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- ── HEADER SHEET ───────────────────────────────────────────── -->
            <!-- Hero + chart share the toolbar's colour and end in a round bottom edge, so the
                 page colour shows as a seam under them. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_sheet_bottom">

            <!-- ── HERO PORTFOLIO ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/card_portfolio_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone">

                <!-- Portfolio Value label (left) + Date (right) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Portfolio Value"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:letterSpacing="0.02"/>

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:fontFamily="@font/geist_mono"
                        android:letterSpacing="0.04"
                        tools:text="TUE, 28 APR 2026"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_portfolio_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp"
                    android:fontFamily="@font/inter"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.01"
                    android:singleLine="true"
                    tools:text="₹12,34,567"/>

                <!-- P&L chip + spacer + Invested (right); stacks under large system text (LargeText) -->
                <LinearLayout
                    android:id="@+id/row_pnl_invested"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tv_portfolio_pnl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_bold"
                        android:fontFeatureSettings="tnum"
                        android:visibility="gone"
                        tools:text="↗ +₹14,200  (+5.9%)"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <LinearLayout
                        android:id="@+id/ll_invested_row"
                        android:tag="invested"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Invested "
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:fontFamily="@font/geist_mono"/>

                        <TextView
                            android:id="@+id/tv_invested_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/geist_mono"
                            tools:text="₹11,62,092"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_amount_inline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="placeholder"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tap_for_breakdown"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    tools:ignore="SmallSp"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"/>
            </LinearLayout>

            <!-- ── PORTFOLIO CHART ────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/ll_portfolio_chart_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Chart -->
                <FrameLayout
                    android:id="@+id/fl_portfolio_chart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="4dp">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/portfolio_line_chart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <ProgressBar
                        android:id="@+id/portfolio_chart_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"/>

                    <!-- Reserves the chart's space during the first load so nothing below it jumps -->
                    <View
                        android:id="@+id/v_chart_skeleton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/surface_variant"
                        android:importantForAccessibility="no"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- Shown instead of the chart when a range has no price history -->
                <TextView
                    android:id="@+id/tv_chart_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="24dp"
                    android:text="@string/chart_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"/>

                <!-- Range selector: six equal-weight chips (1D ... ALL) share the full width. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_range_1d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/chart_range_1d"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_secondary"
                        android:contentDescription="@string/chart_range_1d_desc"/>
                    <TextView
                        android:id="@+id/tv_range_1w"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/chart_range_1w"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_secondary"
                        android:contentDescription="@string/chart_range_1w_desc"/>
                    <TextView
                        android:id="@+id/tv_range_1m"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/chart_range_1m"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_secondary"
                        android:contentDescription="@string/chart_range_1m_desc"/>
                    <TextView
                        android:id="@+id/tv_range_3m"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/chart_range_3m"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_secondary"
                        android:contentDescription="@string/chart_range_3m_desc"/>
                    <TextView
                        android:id="@+id/tv_range_1y"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/chart_range_1y"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_secondary"
                        android:contentDescription="@string/chart_range_1y_desc"/>
                    <TextView
                        android:id="@+id/tv_range_all"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/chart_range_all"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_secondary"
                        android:contentDescription="@string/chart_range_all_desc"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/chart_caption"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"/>
            </LinearLayout>
            </LinearLayout>

            <!-- ── TODAY'S MOVERS ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S MOVERS"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    tools:ignore="SmallSp"
                    android:fontFamily="@font/inter_semi_bold"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:paddingHorizontal="20dp"/>

                <!-- Horizontal scroll of mover chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/ll_top_movers_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:visibility="gone"/>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/top_mover_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_index_card"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add investments to your portfolio to see today's movers"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/top_mover_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_index_card"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading market data…"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"/>
                </LinearLayout>
            </LinearLayout>


            <!-- ── MARKET STATUS ROW ──────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Markets"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semi_bold"/>

                <LinearLayout
                    android:id="@+id/chip_india_market"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_market_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_india_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NSE  "
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.04"/>

                    <TextView
                        android:id="@+id/tv_india_market_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Closed"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_bold"
                        tools:text="Open"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chip_us_market"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_market_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_us_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NYSE  "
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.04"/>

                    <TextView
                        android:id="@+id/tv_us_market_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Closed"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_bold"
                        tools:text="Closed"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── INDIA LABEL ────────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="20dp"
                android:text="INDIA"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp"
                android:fontFamily="@font/inter_semi_bold"
                android:letterSpacing="0.16"
                android:textAllCaps="true"/>

            <!-- ── INDIA INDEX CARDS ──────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:id="@+id/card_nifty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_index_card"
                    android:padding="14dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIFTY 50"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tv_nifty_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="@font/geist_mono_bold"
                        android:singleLine="true"
                        tools:text="23,408"/>

                    <TextView
                        android:id="@+id/tv_nifty_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="@font/geist_mono"
                        tools:text="↘ -0.73%"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_sensex"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_index_card"
                    android:padding="14dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SENSEX"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tv_sensex_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="@font/geist_mono_bold"
                        android:singleLine="true"
                        tools:text="76,985"/>

                    <TextView
                        android:id="@+id/tv_sensex_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="@font/geist_mono"
                        tools:text="↗ +0.42%"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── US LABEL ───────────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="20dp"
                android:text="UNITED STATES"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp"
                android:fontFamily="@font/inter_semi_bold"
                android:letterSpacing="0.16"
                android:textAllCaps="true"/>

            <!-- ── US INDEX CARDS ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:id="@+id/card_sp500"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_index_card"
                    android:padding="14dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S&amp;P 500"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tv_sp500_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="@font/geist_mono_bold"
                        android:singleLine="true"
                        tools:text="5,667"/>

                    <TextView
                        android:id="@+id/tv_sp500_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="@font/geist_mono"
                        tools:text="↗ +0.22%"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_nasdaq"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_index_card"
                    android:padding="14dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NASDAQ"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tv_nasdaq_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
