<?xml version="1.0" encoding="utf-8"?>
<!-- On = ink (black in light, white in dark); off = a visible neutral (the default off track
     blended into the settings card in dark mode, leaving just a floating thumb). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ink" android:state_checked="true"/>
    <item android:color="@color/switch_track_off"/>
</selector>
