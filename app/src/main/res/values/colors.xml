<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="background">#FFFFFF</color>
    <color name="background_dark">#FFFFFF</color>
    <color name="surface_color">#FFFFFF</color>
    <color name="surface_variant">#F4F4F5</color>
    <!-- The layered look: `page` is the floor, `surface_color` the sheets and cards resting on it,
         `surface_variant` the chips and tiles inside a sheet. Light: grey floor, white sheets.
         Dark (values-night): black floor, #18181B sheets. -->
    <color name="page">#F4F4F5</color>
    <color name="error_background">#FEF2F2</color>

    <color name="divider_color">#E4E4E7</color>
    <color name="border_color">#E4E4E7</color>

    <!-- Translucent scrim behind a loading spinner, over existing content -->
    <color name="overlay_scrim">#80FFFFFF</color>

    <color name="text_primary">#09090B</color>
    <color name="text_secondary">#52525B</color>
    <color name="text_tertiary">#6B6B75</color>

    <!-- ── Marker palette ──────────────────────────────────────────────────────
         The neon marks only what needs the user, ink shows what's selected, and money
         direction is coloured text. -->

    <!-- The marker: ONLY for things that need the user (update banner, add actions,
         data-quality warnings, active-tab dot, launch mark). Never gains, selection or
         state. Constant in both themes, and always carries on_marker ink (18.3:1). -->
    <color name="marker">#F3FE78</color>
    <color name="on_marker">#09090B</color>

    <!-- Ink: selected chips and tabs, "on" switches, open-market chip, filled buttons.
         Flips in values-night, so it never disappears into the dark background. -->
    <color name="ink">#09090B</color>
    <color name="on_ink">#FFFFFF</color>

    <!-- Money direction as coloured TEXT, never a filled pill. At least 4.85:1 on every
         surface and colour-blind safe as a pair. A move that shows as 0.00 uses text_secondary. -->
    <color name="gain">#087A5A</color>
    <color name="loss">#C2380E</color>

    <!-- Destructive actions and errors: the loss hue, but a separate job. -->
    <color name="danger">@color/loss</color>
    <color name="on_danger">@color/on_ink</color>

    <!-- Dotted fill under the Home chart: ink dots, faint enough to sit behind the line. -->
    <color name="chart_dots">#4009090B</color>

    <!-- Hairline on top of the black nav bar: the bar's own black in light, #27272A in dark. -->
    <color name="nav_bar_divider">#09090B</color>

    <!-- Constant black / white in both themes: settings icon tiles and the pull-to-refresh arrow
         (its disc is always light). Anything drawn on the page that must flip uses ink / on_ink. -->
    <color name="primary">#09090B</color>
    <color name="primary_variant">#F4F4F5</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- Nav bar (black) -->
    <color name="nav_bar_bg">#09090B</color>
    <color name="nav_icon_active">#FFFFFF</color>
    <color name="nav_icon_inactive">#71717A</color>
    <!-- Inactive LABEL text on the constant-black bar: #71717A was 4.1:1 (fails AA for small text) -->
    <color name="nav_label_inactive">#8B8B95</color>

    <color name="widget_background">#E6FFFFFF</color>
    <color name="widget_surface">#E6F4F4F5</color>

    <!-- Asset categories: fixed per type, never by rank; dark steps in values-night.
         Indian vs US stocks is ΔE 13 for colour-blind readers (the old blue/violet was 1.3). -->
    <color name="cat_stock_in">#2A78D6</color>
    <color name="cat_stock_us">#E87BA4</color>
    <color name="cat_mf">#008300</color>
    <color name="cat_gold">#EDA100</color>
    <color name="cat_silver">#1BAF7A</color>
    <color name="cat_crypto">#EB6834</color>
    <color name="cat_cash">#4A3AA7</color>
    <color name="cat_bank">#94582A</color>
    <!-- Switch, off state: track must stand apart from the card it sits on -->
    <color name="switch_track_off">#D4D4D8</color>
    <color name="switch_thumb_off">#FFFFFF</color>
</resources>
