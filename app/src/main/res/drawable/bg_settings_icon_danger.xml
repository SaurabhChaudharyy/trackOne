<?xml version="1.0" encoding="utf-8"?>
<!-- Icon tile for destructive settings rows (e.g. Clear Local Data) — a tinted-red
     square instead of the default solid-black bg_settings_icon, so the row reads
     as dangerous before you even parse the text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/loss_red_bg"/>
    <corners android:radius="8dp"/>
</shape>
